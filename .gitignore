# 构建产物（由 scripts/build.mjs 从 src/ 生成，不入库）
lib/

# 依赖
node_modules/
pnpm-lock.yaml

# 本工作区自己产生的计划数据。
# 说明：plan/ 是「个人计划数据」，不是插件源码——把它提交进插件仓库会让
# 你的私人计划混进开源/共享历史里。你自己真正用来办公的那些工作区里，
# plan/ 应当正常提交（那才是「计划与产出同仓、可回溯」的用法）。
# 若你确实想让本仓库也跟踪计划，删掉下面这行即可。
plan/

# 编辑器 / 系统
.DS_Store
*.swp
.idea/
.vscode/

# WorkBuddy 在本地写下的 agent 工作笔记（本机状态，不是插件源码）
.workbuddy/

# DSH 自己的本机状态：环境记录等（本机状态，不上传）
# 注意 .dsh/skills/ 是 DSH 的项目级技能目录，将来若要共享需单独放开
.dsh/*
!.dsh/skills/
